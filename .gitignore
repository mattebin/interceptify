# Build artifacts
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.exe.new
_interceptify_update.bat

# IDE
.vscode/
.idea/

# Runtime state (never push)
config.json
proxy_snapshot.json
blocked.log
# Per-machine overrides + whatever self-heal discovered on this install. The
# SHIPPED defaults (extensions/adblock.config.json) ARE tracked; this is the
# file that must survive an update, so it can never be part of one.
extensions/adblock.config.local.json
# Marker recording that WE turned Spotify's developer-mode flag on, so we only
# ever turn off our own change.
.interceptify-devtools-owned

# --- Legacy network-proxy code ---
# Spotify 1.2.88+ ignores the Windows system proxy, so the mitmproxy
# pipeline no longer works for Spotify. These files stay on disk locally
# but are not part of the public Interceptify project.
apps.json
bypass.txt
cert_manager.py
filters/
proxy_addon.py
proxy_watchdog.py
system_proxy.py
test_safety.py

# Local-only analysis / diagnostic helpers
ad_detective.py
ad_detective.log
afk_monitor.py
afk_monitor.log
cdp_eval.py
diag_*.py
hotfix_*.py
dump_run.py
run_dump_*.json

# Session capture artifacts (ephemeral CDP/network diagnostic dumps, 2026-06-13)
capture_*.json
netlog_*.jsonl
sni_log.txt
*.pcapng

# Self-healing automation. selfheal.py is now TRACKED: it is executed by three
# scheduled tasks, and code that runs on a schedule with no version control has
# no history and no rollback. It became shareable once the incident-log
# destination moved out of the source and into config.json / an env var, so the
# file no longer contains anything personal.
# Its OUTPUTS stay ignored - they are machine state, not source.
selfheal.state.json
selfheal.report.json
selfheal.log

# Records when this install registered its scheduled tasks, so "has never run"
# is not reported for a task that has not had a chance to yet.
.tasks-installed
